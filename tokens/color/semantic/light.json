{
  "semantic": {
    "surface": {
      "primary":  { "$value": "{color.white}",    "$type": "color" },
      "secondary": { "$value": "{color.grey.100}", "$type": "color" },
      "tertiary": { "$value": "{color.grey.200}", "$type": "color" },
      "overlay":  { "$value": "#000000CC",         "$type": "color" },
      "elevated": { "$value": "{color.white}",    "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "{color.grey.950}", "$type": "color" },
      "secondary": { "$value": "{color.grey.700}", "$type": "color" },
      "tertiary":  { "$value": "{color.grey.400}", "$type": "color" },
      "disabled":  { "$value": "{color.grey.300}", "$type": "color" },
      "inverse":   { "$value": "{color.white}",    "$type": "color" }
    },
    "icon": {
      "primary":   { "$value": "{color.grey.950}", "$type": "color" },
      "secondary": { "$value": "{color.grey.700}", "$type": "color" },
      "tertiary":  { "$value": "{color.grey.400}", "$type": "color" },
      "disabled":  { "$value": "{color.grey.300}", "$type": "color" },
      "inverse":   { "$value": "{color.white}",    "$type": "color" }
    },
    "border": {
      "subtle":  { "$value": "{color.grey.100}", "$type": "color" },
      "default": { "$value": "{color.grey.200}", "$type": "color" },
      "strong":  { "$value": "{color.grey.300}", "$type": "color" },
      "focus":       { "$value": "{color.grey.950}", "$type": "color" },
      "divider":     { "$value": "{color.grey.200}", "$type": "color" },
      "translucent": { "$value": "#0000000A",        "$type": "color" }
    },
    "status": {
      "error":             { "$value": "{color.error.600}",   "$type": "color" },
      "warning":           { "$value": "{color.warning.600}", "$type": "color" },
      "success":           { "$value": "{color.success.600}", "$type": "color" },
      "info":              { "$value": "{color.info.600}",    "$type": "color" },
      "errorBackground":   { "$value": "{color.error.100}",   "$type": "color" },
      "warningBackground": { "$value": "{color.warning.100}", "$type": "color" },
      "successBackground": { "$value": "{color.success.100}", "$type": "color" },
      "infoBackground":    { "$value": "{color.info.100}",    "$type": "color" }
    },
    "accent": {
      "primary": { "$value": "{color.info.600}", "$type": "color" },
      "content": { "$value": "{color.white}",    "$type": "color" }
    }
  }
}
